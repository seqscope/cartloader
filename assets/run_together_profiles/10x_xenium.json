{
  "platform": "10x_xenium",
  "ingest": {
    "sge_platform": "10x_xenium",
    "autodetect": [
      { "file": "transcripts.csv.gz", "flag": "--in-csv" },
      { "file": "transcripts.parquet", "flag": "--in-parquet" },
      { "file": "transcripts/transcripts.parquet", "flag": "--in-parquet" }
    ],
    "csv_colnames_others": ["cell_id", "z_location", "overlaps_nucleus", "nucleus_distance"],
    "extra_flags": ["--sge-visual"]
  },
  "roles": {
    "xy":         { "file": "cells.csv.gz", "colname_x": "x_centroid", "colname_y": "y_centroid" },
    "boundaries": { "file": "cell_boundaries.csv.gz" },
    "clusters":   { "file": "analysis/clustering/gene_expression_graphclust/clusters.csv" }
  },
  "ficture": [
    { "id": "denovo", "mode": "train", "width": "12", "n_factor": "12,24,48" }
  ],
  "cell_analyses": [
    { "id": "cartloader",   "uses": ["boundaries", "xy"] },
    { "id": "xeniumranger", "uses": ["clusters", "boundaries", "xy"], "multi_import": "import_xenium_cell" }
  ],
  "cartload": { "use_pmpoint": true, "bin_count": 500 },
  "images": [
    { "id": "dapi",     "match": "morphology_focus/morphology_focus_0000.ome.tif", "kind": "single", "color": "0F73E6", "convert": "ome2png" },
    { "id": "boundary", "match": "morphology_focus/morphology_focus_0001.ome.tif", "kind": "single", "color": "F300A5", "convert": "ome2png" },
    { "id": "rna",      "match": "morphology_focus/morphology_focus_0002.ome.tif", "kind": "single", "color": "A4A400", "convert": "ome2png" },
    { "id": "protein",  "match": "morphology_focus/morphology_focus_0003.ome.tif", "kind": "single", "color": "008A00", "convert": "ome2png" },
    { "id": "dapi",     "match": "morphology_focus.ome.tif", "kind": "single", "color": "0F73E6", "convert": "ome2png" },
    { "id": "dapi",     "match": "morphology.ome.tif", "kind": "single", "color": "0F73E6", "convert": "ome2png", "extra_flags": ["--use-middle-page", "--high-memory"] }
  ]
}
